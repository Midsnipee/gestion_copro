# Nom de domaine (HTTPS automatique). Obligatoire pour l'usage hors ligne sur tablette et téléphone.
# :80 ne convient que pour un essai depuis le serveur lui-même (http://localhost).
DOMAINE=:80

# Mots de passe Postgres (générer : openssl rand -base64 24)
PG_PASSWORD=
PS_PASSWORD=

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Modèles par tâche — https://openrouter.ai/models
MODEL_REDACTION=anthropic/claude-sonnet-4.5
MODEL_CHAT=anthropic/claude-sonnet-4.5
MODEL_EXTRACTION=google/gemini-2.5-flash

# DOMAINE=copro.mondomaine.fr  -> certificat Let's Encrypt automatique
# DOMAINE=:80                 -> HTTP simple, uniquement pour un test sur le poste (localhost)
{$DOMAINE::80} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:3000
	}

	# Flux de synchronisation PowerSync (le préfixe est retiré)
	handle_path /powersync/* {
		reverse_proxy powersync:8080 {
			flush_interval -1
		}
	}

	# Application (PWA)
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		header /sw.js Cache-Control "no-cache"
		header /index.html Cache-Control "no-cache"
	}
}

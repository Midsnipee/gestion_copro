{
  "name": "@copro/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts src/cli.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist --packages=external --alias:@copro/shared/tables=../shared/src/tables.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@copro/shared": "*",
    "fastify": "^5.12.8",
    "jose": "^6.2.15",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
